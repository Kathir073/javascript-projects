rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.isAdmin == true;
    }

    function isReadRequest() {
      return request.method == 'get' || request.method == 'list';
    }

    match /news/{docId} {
      allow read: if true; // public
      allow write: if isAdmin();
    }

    match /directory/{docId} {
      allow read: if true; // public
      allow write: if isAdmin();
    }

    match /jobs/{docId} {
      allow read: if true; // public
      allow write: if isAdmin();
    }

    match /marketplace/{docId} {
      allow read: if resource.data.approved == true;
      allow write: if isAdmin();
    }

    match /transport_trains/{docId} {
      allow read: if true; // public
      allow write: if isAdmin();
    }

    match /transport_buses/{docId} {
      allow read: if true; // public
      allow write: if isAdmin();
    }

    match /device_tokens/{docId} {
      allow read: if false; // not public
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}